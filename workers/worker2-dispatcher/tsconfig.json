{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "shared": ["../../shared/src/index.ts"],
      "shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
