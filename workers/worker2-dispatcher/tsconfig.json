{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "paths": {
      "shared": ["../../shared/src/index.ts"],
      "shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
