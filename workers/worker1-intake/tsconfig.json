{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    // skipLibCheck ป้องกัน conflict ระหว่าง worker-configuration.d.ts กับ @cloudflare/workers-types
    // ที่ src/ ยังอ้างถึงผ่าน triple-slash reference
    "skipLibCheck": true,
    "paths": {
      "shared": ["../../shared/src/index.ts"],
      "shared/*": ["../../shared/src/*"]
    }
  },
  // รวม worker-configuration.d.ts ที่ generate จาก `wrangler types`
  // ไฟล์นี้มี typed Env interface + runtime types ครบจาก wrangler v4
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
