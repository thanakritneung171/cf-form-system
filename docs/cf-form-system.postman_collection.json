          "name": "Login (POST)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "username", "value": "admin", "type": "text" },
                { "key": "password", "value": "your-password", "type": "text" },
                { "key": "next", "value": "/admin/submissions", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{W1_BASE_URL}}/admin/login",
              "host": ["{{W1_BASE_URL}}"],
              "path": ["admin", "login"]
            },
            "description": "Login เพื่อรับ session cookie\nRate limit: 5 ครั้ง / 10 นาที / IP\n\nหลัง login สำเร็จจะได้รับ Set-Cookie: admin_session=...\nให้ copy ค่า cookie มาใส่ใน variable SESSION_COOKIE"
          }
        },
        {
          "name": "Logout (POST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "admin_session={{SESSION_COOKIE}}", "type": "text" }
            ],
            "url": {
              "raw": "{{W1_BASE_URL}}/admin/logout",
              "host": ["{{W1_BASE_URL}}"],
              "path": ["admin", "logout"]
            }
          }
        }
      ]
    },
    {
