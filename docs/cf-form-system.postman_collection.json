{
  "info": {
    "_postman_id": "cf-form-system-collection",
    "name": "CF Form System",
    "description": "API Collection สำหรับ CF Form System — Worker 1 (Intake + Admin) และ Worker 2 (Dispatcher Health)\n\nBase URLs:\n- Worker 1 (Local): http://localhost:8787\n- Worker 1 (Production): https://worker1-intake.<subdomain>.workers.dev\n- Worker 2 (Local): http://localhost:8788\n- Worker 2 (Production): https://worker2-dispatcher.<subdomain>.workers.dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "W1_BASE_URL",
      "value": "http://localhost:8787",
      "type": "string",
      "description": "Worker 1 base URL"
    },
    {
      "key": "W2_BASE_URL",
      "value": "http://localhost:8788",
      "type": "string",
      "description": "Worker 2 base URL"
    },
    {
      "key": "SESSION_COOKIE",
      "value": "",
      "type": "string",
      "description": "ค่า admin_session cookie (copy มาจาก browser หลัง login)"
    },
    {
      "key": "SUBMISSION_ID",
      "value": "",
      "type": "string",
      "description": "Submission UUID สำหรับทดสอบ detail/retry"
    },
    {
      "key": "USER_ID",
      "value": "",
      "type": "string",
      "description": "User ID สำหรับทดสอบ edit/delete"
    },
    {
      "key": "WEBHOOK_ID",
      "value": "",
      "type": "string",
      "description": "Webhook ID สำหรับทดสอบ detail/toggle/delete/test"
    },
    {
      "key": "FILE_ID",
      "value": "",
      "type": "string",
      "description": "File ID สำหรับทดสอบ download"
    }
  ],
