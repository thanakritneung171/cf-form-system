          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{W2_BASE_URL}}/health",
              "host": ["{{W2_BASE_URL}}"],
              "path": ["health"]
            },
            "description": "ตรวจสอบสถานะ Worker 2"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"ok\": true, \"worker\": \"worker2-dispatcher\"}"
            }
          ]
        }
      ]
    },
