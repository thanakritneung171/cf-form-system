                { "key": "to", "value": "2026-04-08", "disabled": true },
                { "key": "q", "value": "somchai", "disabled": true }
              ]
            },
            "description": "ดู submissions ที่ pending/dispatching/failed\nQuery params: page, form_type, status, from, to, q"
