BASE_URL=http://localhost:8787
LOAD_TEST_TOKEN=dev-token

# ── Scenario 10 — Cloudflare Waiting Room wave test ──────────────────────────
# TARGET_URL        URL ที่จะยิง wave test
# VUS               จำนวน virtual users ที่เริ่มพร้อมกัน
# SESSION_SECONDS   เวลาที่ VU ถือ session หลัง admit
# POLL_TIMEOUT_SEC  เวลาสูงสุดที่ยอมรอในคิวก่อน timeout
# LOG_DIR           folder สำหรับไฟล์ summary .log (relative to cwd, ต้อง mkdir เอง)
TARGET_URL=https://formsystem.softdebut.online/
VUS=250
SESSION_SECONDS=60
POLL_TIMEOUT_SEC=600
LOG_DIR=logs
