          <hashTree/>
        </hashTree>
        <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Think 500ms" enabled="true"><stringProp name="ConstantTimer.delay">500</stringProp></ConstantTimer>
        <hashTree/>
      </hashTree>

