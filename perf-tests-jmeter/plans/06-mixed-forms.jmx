              <elementProp name="frequency" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.name">frequency</stringProp><stringProp name="Argument.value">ทุกสัปดาห์</stringProp><stringProp name="Argument.metadata">=</stringProp><boolProp name="HTTPArgument.use_equals">true</boolProp></elementProp>
            </collectionProp>
